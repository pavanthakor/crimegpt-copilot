# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# Virtual environments
venv/
.venv/
env/

# Environment variables (secrets — never commit)
.env
*.env
backend/.env
.env.local
.env.*.local
# ...but the placeholder template IS source and must stay tracked.
!.env.example
!backend/.env.example

# Storage / uploads (runtime output: evidence, chroma, whisper models, audio)
storage/
# Generated documents — output of the generation engine, not source.
backend/app/storage/documents/*.docx
backend/app/storage/**/*.docx

# DEMO_MODE output cache — regenerated by app.demo_cache_build from the pool and
# templates/_labels.py, not hand-written source.
backend/demo_cache/analysis/*.json
backend/demo_cache/documents/*.json
backend/demo_cache/transcripts/*.json
# ...but the hand-reviewed Gujarati pin IS source and must stay tracked.
!backend/demo_cache/reviewed_gu.json

# Generated review dumps
_review_*.txt

# OS
.DS_Store
Thumbs.db
