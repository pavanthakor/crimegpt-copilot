# Frontend configuration. Copy to .env.local to override; every value below is the
# built-in default, so the app runs correctly with no .env.local at all.

# --- Idle auto-logout -------------------------------------------------------
# An unattended terminal left signed in is a way into the case file, so the session
# ends after a period with nobody there. See frontend/lib/idle.ts.

# How long a session survives with no activity. Default 15 minutes.
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=15

# Overrides the minutes setting when > 0. For a demo, set this to 30 so the whole
# behaviour — warning, sign-out, sign back in — fits inside a minute.
NEXT_PUBLIC_IDLE_TIMEOUT_SECONDS=0

# How long before sign-out the warning notice appears. Default 60 seconds, and
# automatically capped at half the timeout so a short demo timeout still shows a
# period of normal use before the warning.
NEXT_PUBLIC_IDLE_WARNING_SECONDS=60
